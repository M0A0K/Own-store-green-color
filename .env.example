# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (defaults to 3000)
PORT="3000"

# Cloud SQL / PostgreSQL Connection Variables (Object Method)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# Admin Dashboard Security Credentials
ADMIN_EMAIL="makkhera1@gmail.com"
ADMIN_ACCESS_KEY="OWNVERSE-ADMIN-2026"
ADMIN_SESSION_SECRET="ownverse-production-hmac-secret-2026"

# Discord Webhook for Order & Status Notifications (Backend-only, never exposed to frontend)
DISCORD_WEBHOOK_URL=""

# Minecraft Server Status Target IP
MINECRAFT_SERVER_IP="play.ownverse.mc"
